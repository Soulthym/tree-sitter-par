{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "par",
      "camelcase": "Par",
      "title": "Par",
      "scope": "source.par",
      "file-types": [
        "par"
      ],
      "injection-regex": "^par$",
      "class-name": "TreeSitterPar"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Par (⅋) is an experimental concurrent programming language. It's an attempt to bring the expressive power of linear logic into practice.",
    "authors": [
      {
        "name": "Thybault Alabarbe",
        "email": "thybault.alabarbe@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/Soulthym/tree-sitter-par"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}